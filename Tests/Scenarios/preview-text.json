{"name": "preview-text",
 "fixture": {"files": ["big.txt"], "dirs": [], "sizes": {"big.txt": 300000}, "contents": {"small.txt": "hello preview\nsecond line\n"}},
 "steps": [
  {"expect": {"previewState": "hidden"}},
  {"key": "opt+p"}, {"waitFor": {"previewState": "nothing"}},
  {"click": "small.txt"}, {"waitFor": {"previewState": "text", "previewTextPrefix": "hello preview"}},
  {"click": "big.txt"}, {"waitFor": {"previewState": "text", "previewTextPrefix": "xxxxxxxxxx"}},
  {"key": "opt+p"}, {"waitFor": {"previewState": "hidden"}}
 ]}
