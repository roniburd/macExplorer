{"name": "forward-to-missing-folder",
 "fixture": {"files": ["a/x.txt", "b.txt"], "dirs": ["a"]},
 "steps": [
  {"click": "a"}, {"key": "return"}, {"waitFor": {"folder": "a", "rows": ["x.txt"]}},
  {"key": "cmd+["}, {"waitFor": {"folder": "", "rows": ["a", "b.txt"]}},
  {"click": "a"}, {"command": "moveToTrash"}, {"waitFor": {"rows": ["b.txt"], "filesAbsent": ["a"]}},
  {"key": "cmd+]"},
  {"waitFor": {"folder": "", "rows": ["b.txt"], "banner": "'a' was moved or deleted"}}
 ]}
