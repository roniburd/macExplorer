{"name": "search-hidden-toggle",
 "fixture": {"files": ["needle-top.txt", ".needle-dot.txt", ".dotdir/needle-under-dot.txt", "a/.needle-sub-dot.txt"], "dirs": [],
             "hidden": ["needle-hidden-flag.txt"]},
 "steps": [
  {"key": "cmd+f"}, {"waitFor": {"focus": "fieldEditor"}},
  {"type": "needle"}, {"waitFor": {"rows": ["needle-top.txt"]}},
  {"setSearchScope": "subfolders"},
  {"waitFor": {"searchState": "complete", "resultCount": 1}},
  {"expect": {"rows": ["needle-top.txt"]}},
  {"command": "toggleHidden"},
  {"waitFor": {"searchState": "complete", "resultCount": 5}},
  {"expect": {"rowCount": 5, "rowsContain": [".needle-dot.txt", ".needle-sub-dot.txt", "needle-hidden-flag.txt", "needle-top.txt", "needle-under-dot.txt"]}},
  {"command": "toggleHidden"},
  {"waitFor": {"searchState": "complete", "resultCount": 1}},
  {"expect": {"rows": ["needle-top.txt"]}}
 ]}
